{# data.j2 — Data Documentation (EU AI Act Art. 10 / Art. 11, Annex IV).
   Every field shows: status, strategy, content, evidence. An ABSTAINED field is a correct result. #}
{% macro render(fid) -%}
{% set f = fields[fid] %}
{% if f.status == "filled" %}{% set badge = "✅ filled" %}
{% elif f.status == "partial" %}{% set badge = "🟡 partial evidence" %}
{% elif f.status == "abstained" %}{% set badge = "⛔ ABSTAINED — no evidence in repository" %}
{% elif f.status == "not_observable" %}{% set badge = "⚪ not observable in repository artefacts" %}
{% elif f.status == "human_required" %}{% set badge = "✍️ REQUIRES HUMAN INPUT" %}
{% else %}{% set badge = f.status %}{% endif %}
### {{ f.label }}
<sub>strategy: `{{ f.strategy }}` · status: **{{ badge }}**</sub>

{% if f.value is not none %}
{{ f.value | fmt }}
{% else %}
_{{ f.note or "Not provided." }}_
{% endif %}
{% if f.sources %}

<details><summary>Evidence ({{ f.sources | length }})</summary>

{% for s in f.sources %}
- `{{ s.file }}{% if s.line %}:{{ s.line }}{% endif %}`{% if s.detail %} — {{ s.detail }}{% endif %}{% if s.kind %} ({{ s.kind }}{% if s.score %}, bm25={{ s.score }}{% endif %}){% endif %}
{% endfor %}
</details>
{% endif %}

{% endmacro -%}
